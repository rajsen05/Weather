# SkyGuard AI Configuration

# Application
PROJECT_NAME="SkyGuard AI"
ENVIRONMENT="development"
DEBUG=true

# Security
JWT_SECRET="skyguard-meteorological-super-secure-secret-key-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: Local zero-setup SQLite
DATABASE_URL="sqlite:///./skyguard.db"
# Production MySQL Example:
# DATABASE_URL="mysql+pymysql://skyguard_user:skyguard_pass@localhost:3306/skyguard_ai"

# Weather Providers
PRIMARY_PROVIDER="open_meteo" # Options: open_meteo, open_weather, imd
OPENMETEO_BASE_URL="https://api.open-meteo.com/v1/forecast"
OPENMETEO_GEOCODING_URL="https://geocoding-api.open-meteo.com/v1/search"

# Optional Secondary Providers
OPENWEATHER_API_KEY=""
IMD_API_KEY=""
IMD_ENDPOINT=""

# Scheduler & Real-Time Polling
WEATHER_REFRESH_SECONDS=60
DATA_STALE_THRESHOLD_SECONDS=300

# Machine Learning & Anomaly Tuning
ISOLATION_FOREST_CONTAMINATION=0.05
Z_SCORE_THRESHOLD=3.0
VERIFICATION_WINDOW_SIZE=3
CONSENSUS_AGREEMENT_THRESHOLD=0.85
